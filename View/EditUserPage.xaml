<Page x:Class="Olympiad.View.EditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditUserPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0" Margin="10,10,10,10" Grid.RowSpan="2" CornerRadius="10" Background="{DynamicResource MainBackground}">
            <StackPanel Margin="10">
                <TextBlock Foreground="White" TextAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" FontSize="16">Информация о пользователе</TextBlock>

                <TextBlock Foreground="White"  Margin="5 0" TextAlignment="Left">Логин:</TextBlock>
                <TextBox x:Name="LoginTextBox" IsReadOnly="True" Style="{StaticResource RoundedTextBox}" Margin="5"/>

                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Пароль:</TextBlock>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="5"/>

                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Имя:</TextBlock>
                <TextBox x:Name="FirstNameTextBox" Style="{StaticResource RoundedTextBox}" Margin="5"/>


                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Фамилия:</TextBlock>
                <TextBox x:Name="LastNameTextBox" Style="{StaticResource RoundedTextBox}" Margin="5"/>


                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Отчество:</TextBlock>
                <TextBox x:Name="MiddleNameTextBox" Style="{StaticResource RoundedTextBox}" Margin="5"/>

                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Email пользователя:</TextBlock>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource RoundedTextBox}" Margin="5"/>


                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Дата рождения:</TextBlock>
                <DatePicker x:Name="BirthDatePicker" Margin="5"/>



            </StackPanel>
        </Border>




        <Border Grid.Column="1" Grid.Row="1" Margin="10,10,10,10" CornerRadius="10" Background="{DynamicResource MainBackground}">
            <StackPanel Margin="10">
                <TextBlock Foreground="White" TextAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" FontSize="16">Информация об образовании</TextBlock>

                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Учебное заведение:</TextBlock>
                <TextBox x:Name="InstitutionTextBox" Style="{StaticResource RoundedTextBox}" Margin="5"/>


                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Уровень образования:</TextBlock>
                <ComboBox x:Name="EducationLevelComboBox" Margin="5"/>



                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Курс обучения:</TextBlock>
                <ComboBox x:Name="CourseComboBox" Margin="5"/>



                <TextBlock Foreground="White" Margin="5" TextAlignment="Left">Специализация:</TextBlock>
                <TextBox x:Name="SpecializationTextBox" Style="{StaticResource RoundedTextBox}" Margin="5"/>





                <Button  Grid.Row="2" x:Name="RegisterBtn" Style="{StaticResource MainButton}" Margin="10" Click="EditBtn_Click">Сохранить изменения</Button>
            </StackPanel>
        </Border>


    </Grid>
</Page>
