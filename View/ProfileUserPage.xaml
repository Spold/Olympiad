<Page x:Class="Olympiad.View.ProfileUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfileUserPage">

    <Grid Margin="50 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>


        <!--Кнопка назад-->
        <StackPanel>

            <TextBlock Grid.Column="0"
           Foreground="Black" 
           Margin="20 10" 
           Height="20"
           VerticalAlignment="Center"
           HorizontalAlignment="Left">
    <Hyperlink NavigateUri="OlympiadListView.xaml" 
               Foreground="Black" 
               TextDecorations="None" 
               RequestNavigate="BackArrowlLink">  
        <StackPanel Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
            <Image Source="../Assets/Image/left-arrow.png" 
                   Width="12" 
                   VerticalAlignment="Center"
                   Margin="0 0 5 0"/>
            <TextBlock Text="Назад" 
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Hyperlink>
</TextBlock>
        </StackPanel>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="UserNameTextBlock"
                   FontWeight="Bold"
                   FontSize="24"
                   Margin="10"
                   VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Grid.Row="1">

                <WrapPanel Margin="10 0 50 0" Orientation="Vertical">
                        <TextBlock Text="Email:"/>
                        <TextBlock x:Name="EmailTextBlock"/>
                    </WrapPanel>

                <WrapPanel Margin="50 0" Orientation="Vertical">
                    <TextBlock Text="Дата рождения:"/>
                    <TextBlock x:Name="BirthdayTextBlock"/>
                </WrapPanel>

                <WrapPanel Margin="50 0" Orientation="Vertical">
                    <TextBlock Text="Специальность:"/>
                    <TextBlock x:Name="SpecializationTextBlock"/>
                </WrapPanel>
            </StackPanel>

            <Button Grid.Column="1"  VerticalAlignment="Center" Margin="10" Click="EditProfile_Click"  Style="{StaticResource MainButton}" >Редактировать профиль</Button>

            
        </Grid>

      

    </Grid>
</Page>
