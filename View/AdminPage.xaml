<Page x:Class="Olympiad.View.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Center">
            
            
            <TextBlock Margin="10" TextAlignment="Center">ПАНЕЛЬ АДМИНА</TextBlock>
            
            <Button Height="35" Margin="10" Click="AddUser_Click" Style="{StaticResource MainButton}">
                <TextBlock Text="Добавить преподавателя" 
               TextWrapping="Wrap" 
               TextAlignment="Center"/>
            </Button>

            <Button Height="35" Margin="10" Click="EditProfile_Click" Style="{StaticResource MainButton}">
                <TextBlock Text="Редактировать пользователя" 
               TextWrapping="Wrap" 
               TextAlignment="Center"/>
            </Button>

            <Button Height="35" Margin="10" Click="AddOlimpiada_Click" Style="{StaticResource MainButton}">
                <TextBlock Text="Создать олимпиаду" 
                 TextWrapping="Wrap" 
                 TextAlignment="Center"/>   
            </Button>

            <Button Height="35" Margin="10" Click="Protocols_Click" Style="{StaticResource MainButton}">
                <TextBlock Text="Протоколы" 
                 TextWrapping="Wrap" 
                 TextAlignment="Center"/>       
            </Button>
            
            <Button Height="35" Margin="10" Click="Report_Click" Style="{StaticResource MainButton}">
                <TextBlock Text="Отчеты" 
                  TextWrapping="Wrap" 
                  TextAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Page>
