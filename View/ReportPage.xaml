<Page x:Class="Olympiad.View.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportPage">

    <Grid Margin="50 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Margin="0 20">

            <TextBlock Grid.Column="0"
           Foreground="Black" 
           Margin="20 10" 
           Height="20"
           VerticalAlignment="Center"
           HorizontalAlignment="Left">
    <Hyperlink NavigateUri="OlympiadListView.xaml" 
               Foreground="Black" 
               TextDecorations="None" 
               RequestNavigate="BackArrowlLink">  
        <StackPanel Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
            <Image Source="../Assets/Image/left-arrow.png" 
                   Width="12" 
                   VerticalAlignment="Center"
                   Margin="0 0 5 0"/>
            <TextBlock Text="Назад" 
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Hyperlink>
</TextBlock>
        </StackPanel>

        <Border Grid.Column="0" Margin="10,10,10,10" VerticalAlignment="Center" CornerRadius="10" Background="{DynamicResource MainBackground}">
            <StackPanel Margin="10">
                <TextBlock Foreground="White" TextAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" FontSize="16">Отчет по выбранной олимпиаде</TextBlock>

                <TextBlock Foreground="White"  Margin="5 0" TextAlignment="Left">Выберите олимпиаду:</TextBlock>

                <ComboBox x:Name="OlympiadComboBox" Margin="5">
                </ComboBox>
                <Button  Grid.Row="2" x:Name="ReportOlympiadBtn" Style="{StaticResource MainButton}" Margin="10" Click="CreateOlympiadReport_Click">Создать отчет</Button>

            </StackPanel>
        </Border>



        <Border Grid.Column="1" Grid.Row="1" Margin="10,10,10,10" VerticalAlignment="Center" CornerRadius="10" Background="{DynamicResource MainBackground}">
            <StackPanel Margin="10">
                <TextBlock Foreground="White" TextAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" FontSize="16">Отчет за выбранный год</TextBlock>

                <TextBlock Foreground="White"  Margin="5 0" TextAlignment="Left">Выберите год:</TextBlock>

                <ComboBox x:Name="YearComboBox" Margin="5">
                </ComboBox>

                <Button  Grid.Row="2" x:Name="ReportYearBtn" Style="{StaticResource MainButton}" Margin="10" Click="CreateYearReport_Click">Создать отчет</Button>
            </StackPanel>
        </Border>


    </Grid>
</Page>
