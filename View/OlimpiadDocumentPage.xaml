<Page x:Class="Olympiad.View.OlimpiadDocumentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OlimpiadDocumentPage">


    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                    Padding="20" 
                    CornerRadius="10" 
                    Background="{DynamicResource MainBackground}"
                    MaxWidth="800"
                    HorizontalAlignment="Center">
                    <StackPanel Margin="10,0">
                        <TextBlock Foreground="White" 
                               TextAlignment="Center" 
                               Margin="0,0,0,10" 
                               FontWeight="Bold" 
                               FontSize="16"
                               TextWrapping="Wrap">
                        Документы для олимпиады:
                        </TextBlock>

                        <TextBlock x:Name="OlimpiadTextBlock" 
                              Foreground="White" 
                              TextAlignment="Center" 
                              Margin="0,0,0,10" 
                              FontWeight="Bold" 
                              FontSize="12"
                              TextWrapping="Wrap"/>

                        <StackPanel Margin="0,5">
                            <TextBlock Foreground="White" Margin="5,0" TextAlignment="Left">Положение олимпиады:</TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                     IsReadOnly="True" 
                                     x:Name="PositionTextBox" 
                                     Style="{StaticResource RoundedTextBox}"
                                     Margin="5,0"
                                     MaxWidth="300"
                                     HorizontalAlignment="Stretch"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                                             x:Name="SelectPositionBtn" 
                                             Style="{StaticResource MainButton}" 
                                             Content="Указать" 
                                             Margin="5,0"
                                             MinWidth="80"
                                             Click="SelectPositionBtn_Click"/>

                                    <Button Grid.Column="1" 
                                              x:Name="RemovePositionBtn" 
                                              Style="{StaticResource RedButton}" 
                                              Content="Удалить" 
                                              Margin="5,0"
                                              MinWidth="80"
                                              Click="RemovePositionBtn_Click"/>             
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,5">
                            <TextBlock Foreground="White" Margin="5,0">Архив прошлых заданий олимпиады:</TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                     IsReadOnly="True" 
                                     x:Name="TeskArchiveTextBox" 
                                     Style="{StaticResource RoundedTextBox}"
                                     Margin="5,0"
                                     MaxWidth="300"
                                     HorizontalAlignment="Stretch"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                                             x:Name="SelectArchiveBtn" 
                                             Style="{StaticResource MainButton}" 
                                             Content="Указать" 
                                             Margin="5,0"
                                             MinWidth="80"
                                             Click="SelectArchiveBtn_Click"/>


                                    <Button Grid.Column="1" 
                                             x:Name="RemoveArchiveBtn" 
                                             Style="{StaticResource RedButton}" 
                                             Content="Удалить" 
                                             Margin="5,0"
                                             MinWidth="80"
                                             Click="RemoveArchiveBtn_Click"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,5">
                            <TextBlock Foreground="White" Margin="5,0">Протокол олимпиады:</TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                     IsReadOnly="True" 
                                     x:Name="ProtocolTextBox" 
                                     Style="{StaticResource RoundedTextBox}"
                                     Margin="5,0"
                                     MaxWidth="300"
                                     HorizontalAlignment="Stretch"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" 
                                        x:Name="SelectProtocolBtn" 
                                        Style="{StaticResource MainButton}" 
                                        Content="Указать" 
                                        Margin="5,0"
                                        MinWidth="80"
                                        Click="SelectProtocolBtn_Click"/>
                                    <Button Grid.Column="1" 
                                    x:Name="RemoveProtocolBtn" 
                                    Style="{StaticResource RedButton}" 
                                    Content="Удалить" 
                                    Margin="5,0"
                                    MinWidth="80"
                                    Click="RemoveProtocolBtn_Click"/>
                                </Grid>
                            </Grid>
                        </StackPanel>


                        <StackPanel Margin="0,10">
                            <TextBlock Foreground="White" Margin="5,0">Статус протокола:</TextBlock>
                            <ComboBox x:Name="ProtocolStatusBox" 
                                  Margin="5" 
                                  HorizontalAlignment="Stretch"
                                  />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,15">
                            <Button x:Name="RegisterBtn" 
                                Style="{StaticResource MainButton}" 
                                Margin="5" 
                                MinWidth="120"
                                Content="Обновить"
                                Click="UpdateBtn_Click"/>
                            <Button x:Name="BackBtn" 
                                Style="{StaticResource MainButton}" 
                                Margin="5" 
                                MinWidth="120"
                                Content="Назад"
                                Click="BackBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
