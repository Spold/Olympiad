<Page x:Class="Olympiad.View.OlimpiadDocumentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OlimpiadDocumentPage">
    
    
    <Grid>
        
        

        <Border Grid.Column="0" Margin="200, 30" Grid.RowSpan="2" CornerRadius="10" Background="{DynamicResource MainBackground}">
            <StackPanel Margin="10">
                <TextBlock Foreground="White" TextAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" FontSize="16">Документы для олимпиады:</TextBlock>
                <TextBlock x:Name="OlimpiadTextBlock" Foreground="White" TextAlignment="Center" Margin="0,0,0,10" FontWeight="Bold" FontSize="12"></TextBlock>
                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Положение олимпиады:</TextBlock>
                
                <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBox IsReadOnly="True" x:Name="PositionTextBox" Style="{StaticResource RoundedTextBox}" Width="300"/>
                    <Button x:Name="SelectPositionBtn" Style="{StaticResource MainButton}" Content="Указать" Margin="5 0" Click="SelectPositionBtn_Click"/>
                </StackPanel>

                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Архив прошлых заданий олимпиады:</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBox IsReadOnly="True" x:Name="TeskArchiveTextBox" Style="{StaticResource RoundedTextBox}" Width="300"/>
                    <Button x:Name="SelectArchiveBtn" Style="{StaticResource MainButton}" Content="Указать" Margin="5 0" Click="SelectArchiveBtn_Click"/>
                </StackPanel>

                <TextBlock Foreground="White" Margin="5 0" TextAlignment="Left">Протокол олимпиады:</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBox IsReadOnly="True" x:Name="ProtocolTextBox" Style="{StaticResource RoundedTextBox}" Width="300"/>
                    <Button x:Name="SelectProtocolBtn" Style="{StaticResource MainButton}" Content="Указать" Click="SelectProtocolBtn_Click"/>
                </StackPanel>
                <TextBlock Foreground="White"  Margin="5 0" TextAlignment="Left">Статус протокола:</TextBlock>
                <ComboBox x:Name="ProtocolStatusBox" Margin="5"/>

                <Button  Grid.Row="2" x:Name="RegisterBtn" Style="{StaticResource MainButton}" Margin="10" Click="UpdateBtn_Click">Обновить</Button>
                <Button  Grid.Row="2" x:Name="BackBtn" Style="{StaticResource MainButton}" Margin="10" Click="BackBtn_Click">Назад</Button>
            </StackPanel>
        </Border>



    </Grid>
</Page>
