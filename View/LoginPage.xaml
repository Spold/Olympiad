<Page x:Class="Olympiad.View.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Border  CornerRadius="10" Width="250" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource MainBackground}">
            <StackPanel>
                <TextBlock Foreground="White" Margin="0 20" TextAlignment="Center">Войти в Вашу учетную запись</TextBlock>
                <StackPanel Margin="0 3">
                    <TextBlock Foreground="White" Margin="45 5" TextAlignment="Left">Логин</TextBlock>
                    <TextBox Margin="40 0"  x:Name="LoginTextBox" Height="33" Style="{StaticResource RoundedTextBox}"/>
                    <TextBlock x:Name="LoginErrorBox" TextWrapping="Wrap" Foreground="Red" Margin="45 5" FontSize="7" TextAlignment="Left"/>
                </StackPanel>
                <StackPanel Margin="0 3">
                    <TextBlock Foreground="White" Margin="45 5" TextAlignment="Left">Пароль</TextBlock>
                    <PasswordBox Margin="40 0"  x:Name="PasswordTextBox" Height="33" Style="{StaticResource RoundedPasswordBox}"/>
                    <TextBlock x:Name="PasswordErrorBox" TextWrapping="Wrap" Foreground="Red" Margin="45 5" FontSize="7" TextAlignment="Left"/>
                </StackPanel>

                <Button x:Name="LoginBtn" Click="LoginButton_Click" Margin="0 8"  Style="{StaticResource MainButton}" >Войти</Button>
            </StackPanel>
        </Border>

    </Grid>
</Page>
