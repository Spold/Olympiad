<Page x:Class="Olympiad.View.ProtocolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Olympiad.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProtocolsPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ListView Name="OlympiadProtocolsList" Grid.Row="1" 
              HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" 
                        Background="#D9D9D9" 
                        Margin="30 10"
                        Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <StackPanel Margin="10" Width="300">
                                    <TextBlock Text="Название олимпиады:"/>
                                    <TextBlock Text="{Binding Name}" 
                         FontWeight="Bold"
                         TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="10">
                                    <TextBlock Text="Статус:"/>
                                    <TextBlock Text="{Binding Status}" 
                         FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="ViewReportBtn" Grid.Column="1" Height="35" Margin="10" Click="ReportView_Click" Style="{StaticResource MainButton}">
                                <TextBlock Text="Посмотреть" 
                     TextWrapping="Wrap" 
                     TextAlignment="Center"/>
                            </Button>

                            <Button x:Name="PubhishBtn" Grid.Column="2" Height="35" Margin="10" Click="Report_Click" Style="{StaticResource MainButton}">
                                <TextBlock Text="Опубликовать" 
                     TextWrapping="Wrap" 
                     TextAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
