<Window x:Class="Olympiad.View.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Olympiad.View"
        mc:Ignorable="d"
        Title="InputDialog" Height="200" Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Введите ID пользователя:" Margin="0,0,0,5"/>
        <TextBox x:Name="UserIdTextBox" Grid.Row="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Width="80" Margin="0,20,10,20" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" Margin="10,20,0,20" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
